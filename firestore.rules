rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isReception() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','reception'];
    }
    function isStaff() { return isReception(); }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if signedIn() && (isAdmin() || isOwner(uid));
      allow create, update: if signedIn() && (isAdmin() || isOwner(uid));
      allow delete: if isAdmin();
    }

    match /usersByEmail/{email} {
      // Path-id compare works when the document does not exist yet (resource is null).
      // Emails are stored lowercased; token email is normalized the same way on the client.
      allow read: if isAdmin() || (signedIn() && request.auth.token.email.lower() == email);
      allow create, update, delete: if isAdmin();
    }

    match /clients/{id} {
      allow read: if signedIn() && (isStaff() || resource.data.uid == request.auth.uid);
      allow create: if signedIn() && (isStaff() || request.resource.data.uid == request.auth.uid);
      allow update: if signedIn() && (isStaff() || resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /trainers/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /trainerCategories/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /assignments/{id} {
      allow read: if signedIn() && (isStaff() || resource.data.clientUid == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin() || resource.data.clientUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /subscriptions/{id} {
      allow read: if isStaff() || (signedIn() && resource.data.clientUid == request.auth.uid);
      allow create: if isStaff();
      allow update: if isStaff() || (signedIn() && resource.data.clientUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /visits/{id} {
      allow read: if isStaff() || (signedIn() && resource.data.clientUid == request.auth.uid);
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /audit/{id} {
      allow read, create: if isStaff();
      allow update, delete: if isAdmin();
    }

    // Legacy aggregate storage is staff-only. New PRO data uses the
    // dedicated collections above so clients never receive other users' data.
    match /gym_data/{key} {
      allow read, write: if isStaff();
    }
  }
}