rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid))
        : null;
    }

    function role() {
      return signedIn() && userDoc().exists ? userDoc().data.role : null;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isStaff() {
      return role() == 'admin' || role() == 'reception';
    }

    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /private/{docId} {
        allow read, write: if signedIn() && (uid == request.auth.uid || isAdmin());
      }
    }

    match /gym_data/{docId} {
      allow read: if signedIn() && (
        docId == 'inventory' || isStaff()
      );
      allow create, update, delete: if isStaff();
    }
  }
}
