rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isReception() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','reception'];
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if signedIn() && (isAdmin() || isOwner(uid));
      allow create, update: if signedIn() && (isAdmin() || isOwner(uid));
      allow delete: if isAdmin();
    }

    match /usersByEmail/{email} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /clients/{id} {
      allow read: if signedIn() && (isAdmin() || isReception() ||
        resource.data.uid == request.auth.uid);
      allow create, update: if signedIn() && (isAdmin() || isReception() ||
        request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /trainers/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /trainerCategories/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /assignments/{id} {
      allow read: if signedIn() && (isAdmin() || isReception() ||
        resource.data.clientUid == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin() || resource.data.clientUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /gym_data/{key} {
      allow read: if signedIn();
      allow write: if isAdmin() || isReception();
    }
  }
}
